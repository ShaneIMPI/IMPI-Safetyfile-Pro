# Copy to .env.local for local dev. In production these are set as GitHub Actions secrets.
# Vite only exposes vars prefixed with VITE_ to the browser.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: override the GitHub Pages base path (default: /impi-safetyfile-pro/)
# VITE_BASE=/

# ---------------------------------------------------------------------------
# NOT a browser var. Set this as a Supabase secret for the audit-suggest
# Edge Function:  supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# The browser never sees this key. See DECISIONS.md item 2.
# ANTHROPIC_API_KEY=

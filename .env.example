# Copy to .env.local for local dev. In production these are set as GitHub Actions secrets.
# Vite only exposes vars prefixed with VITE_ to the browser.
#
# Every value below is FOUND IN YOUR NEON CONSOLE once your project exists —
# see README.md steps 1–4. None of them are guessable in advance.

# Postgres data API (Neon Console > your project > Data API). PostgREST-style
# REST endpoint the app queries directly — this is the equivalent of the old
# VITE_SUPABASE_URL, but note there is no separate "anon key": authorization
# comes entirely from the signed-in user's Neon Auth session.
VITE_NEON_DATA_API_URL=https://YOUR-DATA-API-ENDPOINT/rest/v1

# Neon Auth (Managed Better Auth) endpoint (Neon Console > your project > Auth).
VITE_NEON_AUTH_URL=https://YOUR-AUTH-ENDPOINT

# The two Neon Functions this app depends on (Neon Console > your project >
# Functions, once each is deployed — see neon/functions/*).
VITE_NEON_FILE_FN_URL=https://YOUR-FUNCTION-BASE/file-access
VITE_NEON_AUDIT_FN_URL=https://YOUR-FUNCTION-BASE/audit-suggest

# Public base URL for the `logos` bucket (the one public_read bucket) so the
# app can build a plain image URL without going through the file-access
# function for reads. Neon Console > Object Storage > logos > public URL.
VITE_NEON_PUBLIC_FILES_URL=https://YOUR-OBJECT-STORAGE-ENDPOINT/logos

# Optional: override the GitHub Pages base path (default: derived automatically
# from the repo name in CI — see vite.config.js). Only set this for a custom domain.
# VITE_BASE=/

# ---------------------------------------------------------------------------
# NOT browser vars — set these as Function-level environment variables in the
# Neon console (Functions > <function name> > Environment variables), never
# here and never as VITE_ vars, or they'd ship into the public JS bundle.
#
# audit-suggest needs:
#   ANTHROPIC_API_KEY=sk-ant-...        (optional — AI audit hints; see DECISIONS.md item 2)
#
# file-access needs (Object Storage's OWN service credentials, separate from
# your Neon Auth/database credentials — Neon Console > Object Storage > Access keys):
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_ENDPOINT_URL_S3=...
#   AWS_REGION=...
#
# Both functions also need NEON_AUTH_JWKS_URL / NEON_AUTH_BASE_URL / DATABASE_URL,
# which Neon documents as auto-injected — confirm this is still true for your
# project once it exists (see DECISIONS.md addendum 2).
